{
  "expo": {
    "name": "Upshot Brand Media",
    "slug": "upshot-brand-media",
    "version": "1.0.0",
    "scheme": "upshot",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Upshot to access your photos to attach proof of task completion."
        }
      ]
    ]
  }
}
