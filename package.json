{
  "name": "upshot-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @upshot/mobile start",
    "admin": "yarn workspace @upshot/admin dev",
    "admin:build": "yarn workspace @upshot/admin build",
    "type-check": "yarn workspaces run type-check",
    "db:generate": "yarn workspace @upshot/database db:generate",
    "db:push": "yarn workspace @upshot/database db:push",
    "db:migrate": "yarn workspace @upshot/database db:migrate",
    "db:clear": "yarn workspace @upshot/database db:clear",
    "db:studio": "yarn workspace @upshot/database db:studio",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "yarn@4.11.0",
  "resolutions": {
    "react-native": "0.79.6",
    "metro": "0.82.5"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^9.1.0"
  }
}
